{
  "tasks": [
    {
      "id": "photos",
      "name": "Photos",
      "source": "/mnt/nas/photos",
      "dest": "teldrive:/photos",
      "schedule": "0 1 * * *",
      "rclone_flags": "--create-empty-src-dirs --exclude @*/** --ignore-existing --transfers 1 --checkers 2 --tpslimit 3",
      "enabled": true
    },
    {
      "id": "HA_backups",
      "name": "HA Backups",
      "source": "/mnt/backups/HA backups",
      "dest": "teldrive:/HA backups",
      "schedule": "0 3 * * *",
      "rclone_flags": "--create-empty-src-dirs --exclude @*/** --ignore-existing --transfers 1 --checkers 2 --tpslimit 3",
      "enabled": true
    },
    {
      "id": "pve_backups",
      "name": "pve backups",
      "source": "/mnt/pve-backup",
      "dest": "teldrive:/pve_backups",
      "schedule": "0 11 * * *",
      "rclone_flags": "",
      "enabled": true
    }
  ]
}
